<idea-plugin>
  <id>dev.smallproject.entitymanager</id>
  <name>Small Entity Manager</name>
  <version>1.0.0-RC5</version>
  <idea-version since-build="251"/>
  <vendor url="https://git.small-project.dev/pub/ide/small-entity-manager-ide-core">Small Project</vendor>
  <description><![CDATA[Native PHP-free completion and PhpStorm type inference for Small Swoole Entity Manager fields, relations, aliases, and manager factories.]]></description>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.jetbrains.php</depends>
  <extensions defaultExtensionNs="com.intellij">
    <completion.contributor language="PHP" implementationClass="dev.smallproject.ide.SmallCompletionContributor" order="first"/>
    <typedHandler implementation="dev.smallproject.ide.SmallCompletionAutoPopup" order="first"/>
    <completion.confidence language="PHP" implementationClass="dev.smallproject.ide.SmallCompletionConfidence" order="first"/>
    <postStartupActivity implementation="dev.smallproject.ide.SmallProjectIndexStartup"/>
  </extensions>
  <extensions defaultExtensionNs="com.jetbrains">
    <php.typeProvider4 implementation="dev.smallproject.ide.SmallPhpTypeProvider"/>
  </extensions>
  <actions>
    <action id="dev.smallproject.ide.Diagnostics" class="dev.smallproject.ide.SmallCompletionDiagnosticsAction"
            text="Small Entity Manager: Diagnose Completion"
            description="Inspect local query completion context and native index mappings">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
