{
  "name": "small-entity-manager-vscode",
  "displayName": "Small Entity Manager",
  "description": "Static ORM completion for Small Swoole Entity Manager in PHP projects",
  "version": "0.1.0",
  "publisher": "small-project",
  "license": "MIT",
  "private": true,
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Programming Languages", "Other"],
  "keywords": ["Small", "Swoole", "PHP", "ORM", "completion"],
  "main": "./src/extension.js",
  "extensionKind": ["workspace"],
  "activationEvents": ["onLanguage:php", "onCommand:smallEntityManager.refreshIndex", "onCommand:smallEntityManager.showDiagnostics"],
  "repository": { "type": "git", "url": "https://git.small-project.dev/pub/ide/small-entity-manager-ide-core.git" },
  "contributes": {
    "commands": [
      { "command": "smallEntityManager.refreshIndex", "title": "Small Entity Manager: Refresh Index" },
      { "command": "smallEntityManager.showDiagnostics", "title": "Small Entity Manager: Diagnose Completion" }
    ],
    "configuration": {
      "title": "Small Entity Manager",
      "properties": {
        "smallEntityManager.phpExecutable": {
          "type": "string", "default": "php", "scope": "machine",
          "description": "Path to a PHP 8.4+ executable in the VS Code extension host; used only for read-only static indexing."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "bundle-core": "node scripts/bundle-core.js",
    "package:vsix": "npm run test && npm run bundle-core && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "3.6.0"
  }
}
